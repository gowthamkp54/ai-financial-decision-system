{
  "version": 2,
  "routes": [
    { "src": "/api/auth/login",               "dest": "/api/auth/login.js" },
    { "src": "/api/auth/logout",              "dest": "/api/auth/logout.js" },
    { "src": "/api/auth/me",                  "dest": "/api/auth/me.js" },
    { "src": "/api/portfolio/summary",        "dest": "/api/portfolio/summary.js" },
    { "src": "/api/portfolio/goals",          "dest": "/api/portfolio/goals.js" },
    { "src": "/api/portfolio/gemini-key",     "dest": "/api/portfolio/gemini-key.js" },
    { "src": "/api/portfolio/gemini-key-status", "dest": "/api/portfolio/gemini-key.js" },
    { "src": "/api/portfolio",                "dest": "/api/portfolio/index.js" },
    { "src": "/api/chat/send",                "dest": "/api/chat/send.js" },
    { "src": "/api/chat/history",             "dest": "/api/chat/history.js" },
    { "src": "/api/user/profile",             "dest": "/api/user/profile.js" },
    { "src": "/api/user/insights",            "dest": "/api/user/insights.js" },
    { "src": "/login",      "dest": "/pages/login.html" },
    { "src": "/register",   "dest": "/pages/register.html" },
    { "src": "/dashboard",  "dest": "/pages/dashboard.html" },
    { "src": "/portfolio",  "dest": "/pages/portfolio.html" },
    { "src": "/chat",       "dest": "/pages/chat.html" },
    { "src": "/goals",      "dest": "/pages/goals.html" },
    { "src": "/profile",    "dest": "/pages/profile.html" },
    { "src": "/(.*)",       "dest": "/$1" }
  ]
}
